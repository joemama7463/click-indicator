{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "joe.click-indicator",
	"name": "Click Guide",
	"version": "v2.1.0",
	"developer": "Joe",
	"description": "Rhythm-game style guide that shows when to click. Uses your own completions, bot macros (.gdr/.gdr2), or an orb scan. No sound effects.",
	"settings": {
		"enabled": {
			"name": "Enabled",
			"type": "bool",
			"default": true
		},
		"approach-time": {
			"name": "Note Approach Time (seconds)",
			"description": "How early notes appear before you need to click.",
			"type": "float",
			"default": 1.0,
			"min": 0.3,
			"max": 3.0,
			"control": {
				"slider": true
			}
		},
		"perfect-window": {
			"name": "PERFECT Window (ms)",
			"type": "float",
			"default": 35.0,
			"min": 5.0,
			"max": 100.0,
			"control": {
				"slider": true
			}
		},
		"great-window": {
			"name": "GREAT Window (ms)",
			"type": "float",
			"default": 80.0,
			"min": 10.0,
			"max": 200.0,
			"control": {
				"slider": true
			}
		},
		"overwrite-route": {
			"name": "Re-record On Every Completion",
			"description": "If off, a level keeps the first route you recorded.",
			"type": "bool",
			"default": true
		},
		"orb-scan": {
			"name": "Orb Scan When No Route",
			"description": "For levels without a route, put a note on every orb so you get some guidance.",
			"type": "bool",
			"default": true
		},
		"show-judgement": {
			"name": "Show PERFECT/GREAT/MISS Above Track",
			"type": "bool",
			"default": true
		},
		"floating-judgement": {
			"name": "Floating Text On Player",
			"type": "bool",
			"default": true
		},
		"scale": {
			"name": "Scale",
			"type": "float",
			"default": 1.0,
			"min": 0.3,
			"max": 3.0,
			"control": {
				"slider": true
			}
		},
		"opacity": {
			"name": "Opacity",
			"type": "float",
			"default": 1.0,
			"min": 0.1,
			"max": 1.0,
			"control": {
				"slider": true
			}
		},
		"pos-x": {
			"name": "X Position (% of screen)",
			"type": "float",
			"default": 0.1,
			"min": 0.0,
			"max": 1.0,
			"control": {
				"slider": true
			}
		},
		"pos-y": {
			"name": "Y Position (% of screen)",
			"type": "float",
			"default": 0.18,
			"min": 0.0,
			"max": 1.0,
			"control": {
				"slider": true
			}
		}
	}
}