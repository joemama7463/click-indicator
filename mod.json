{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "joe.click-indicator",
	"name": "Click Indicator",
	"version": "v1.0.0",
	"developer": "Joe",
	"description": "Rhythm-game style click indicator: clicks scroll up a track with a PERFECT popup. No sound effects.",
	"settings": {
		"enabled": {
			"name": "Enabled",
			"type": "bool",
			"default": true
		},
		"scale": {
			"name": "Scale",
			"type": "float",
			"default": 1.0,
			"min": 0.3,
			"max": 3.0,
			"control": {
				"slider": true
			}
		},
		"opacity": {
			"name": "Opacity",
			"type": "float",
			"default": 1.0,
			"min": 0.1,
			"max": 1.0,
			"control": {
				"slider": true
			}
		},
		"pos-x": {
			"name": "X Position (% of screen)",
			"type": "float",
			"default": 0.1,
			"min": 0.0,
			"max": 1.0,
			"control": {
				"slider": true
			}
		},
		"pos-y": {
			"name": "Y Position (% of screen)",
			"type": "float",
			"default": 0.18,
			"min": 0.0,
			"max": 1.0,
			"control": {
				"slider": true
			}
		},
		"scroll-speed": {
			"name": "Scroll Speed",
			"type": "float",
			"default": 140.0,
			"min": 40.0,
			"max": 400.0,
			"control": {
				"slider": true
			}
		},
		"show-perfect": {
			"name": "Show PERFECT Above Track",
			"type": "bool",
			"default": true
		},
		"floating-perfect": {
			"name": "Floating PERFECT On Player",
			"type": "bool",
			"default": true
		}
	}
}